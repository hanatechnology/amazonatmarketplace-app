<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release and profile builds get no manifest from src/debug, so the
         permission has to live here or every API call fails in a signed APK. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13+ requires the user to grant notifications at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Saving a refund receipt to the gallery. Android 10+ writes via
         MediaStore and needs no permission at all. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Centring the address map on the customer. Foreground only: the app
         never reads a position with no map on screen. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name=".AmazonatApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Delivers the tapped notification to onMessageOpenedApp instead of
                 launching a fresh activity that loses the payload. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Google Maps SDK key, used by the address location picker.
             Supply it per build with:
               a dart-define is NOT enough — this is a
               native lookup, so set MAPS_API_KEY in android/local.properties
               (or your CI secret store) and it is injected by the Gradle
               manifest placeholder below. A missing key renders a grey tile
               grid, not a crash. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Channel used for notifications that arrive without their own. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="amazonat_default" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
